NODE_ENV=development
PORT=5000

# Neon/PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
FRONT_END_BASE_URL=http://localhost:5173
BACK_END_BASE_URL=http://localhost:5000
BCRYPT_SALT=10

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=7d
INVITE_EXPIRES_IN=7d
FORGET_PASS_ACCESS_EXPIRES_IN=15m

# Gmail app password or another SMTP provider's credentials
SMTP_USERNAME=your-smtp-email
SMTP_PASSWORD=your-smtp-app-password

# ── Audio/Video Calling (WebRTC) ──────────────────────────────
# Ring timeout before an unanswered call is marked 'missed'
# (milliseconds; clamped to a 5s minimum).
# Optional — defaults to 30000. No account needed.
CALL_RING_TIMEOUT_MS=30000
# Max rows returned by GET /api/call/history (1-500).
# Optional — defaults to 200. No account needed.
CALL_HISTORY_LIMIT=200

# Optional additional Socket.IO origins, comma separated
# SOCKET_CORS_ORIGINS=https://your-frontend.vercel.app
